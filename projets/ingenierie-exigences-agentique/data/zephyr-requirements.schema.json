{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://formation-ia-agentique.local/zephyr-requirement.schema.json",
  "title": "Zephyr Requirement",
  "description": "Schéma d'une exigence Zephyr collectée depuis le site reqmgmt.",
  "type": "object",
  "required": [
    "requirement_id",
    "requirement_text",
    "category",
    "subcategory",
    "source_url",
    "status",
    "confidence"
  ],
  "properties": {
    "requirement_id": {
      "type": ["string", "null"],
      "description": "Identifiant original de l'exigence, null si absent."
    },
    "requirement_text": {
      "type": "string",
      "minLength": 1,
      "description": "Texte source ou reformulation signalée."
    },
    "reformulation": {
      "type": "boolean",
      "default": false,
      "description": "Indique si le texte est une reformulation par rapport à la source."
    },
    "title": {
      "type": ["string", "null"],
      "description": "Titre de l'exigence s'il existe."
    },
    "category": {
      "type": "string",
      "enum": [
        "software_requirements",
        "system_requirements",
        "docs",
        "unknown"
      ],
      "description": "Catégorie documentée dans l'arborescence du site."
    },
    "subcategory": {
      "type": "string",
      "description": "Nom du sous-document (ex: atomic_service)."
    },
    "source_url": {
      "type": "string",
      "description": "URL de la page source."
    },
    "source_path": {
      "type": ["string", "null"],
      "description": "Chemin ou ancre dans la page source."
    },
    "source_revision": {
      "type": ["string", "null"],
      "description": "Révision exacte (tag ou SHA) si connue."
    },
    "status": {
      "type": "string",
      "enum": [
        "Observé",
        "Proposition",
        "Candidat",
        "Bloqué",
        "Non vérifié",
        "Vérifié"
      ],
      "description": "Statut de qualification de l'exigence."
    },
    "confidence": {
      "type": "string",
      "enum": [
        "Candidat",
        "Observé",
        "Proposition",
        "Vérifié"
      ],
      "description": "Niveau de confiance du champ ou de l'objet."
    },
    "implementation_links": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Liens observés vers le code."
    },
    "test_links": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Liens observés vers les tests."
    },
    "automotive_mapping": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Correspondances automobiles candidates, séparées du corpus."
    },
    "traceability": {
      "type": "object",
      "description": "Informations de traçabilité (parents, enfants, source)."
    },
    "audit": {
      "type": "object",
      "description": "Résultats de l'audit d'exigence."
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Questions ouvertes détectées sur l'exigence."
    }
  },
  "additionalProperties": true
}
