# Configuration API Mistral
# Copier ce fichier en .env et renseigner votre clé API.
# Le fichier .env ne doit JAMAIS être commité.
MISTRAL_API_KEY=your_mistral_api_key_here

# Backend LLM : 'mistral' (production) ou 'fake' (tests sans API)
LLM_BACKEND=mistral

# Backend Embeddings : 'mistral' (production) ou 'fake' (tests sans API)
EMBEDDING_BACKEND=mistral

# Configuration optionnelle
MISTRAL_MODEL=mistral-large-latest
MISTRAL_EMBEDDING_MODEL=mistral-embed

# Paramètres RAG
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
SIMILARITY_THRESHOLD=0.50

# Stockage ChromaDB
CHROMA_PERSIST_DIR=./chroma_db
